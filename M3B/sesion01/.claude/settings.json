{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./secretos_demo.txt)",
      "WebFetch",
      "WebSearch"
    ],
    "allow": [
      "Bash(.venv/bin/python -m validadores.validar *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/hooks/rol.py\""}]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/hooks/compuerta.py\""}]
      }
    ]
  }
}
